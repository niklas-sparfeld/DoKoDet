{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doko-detector.local/schemas/table-observation-annotation-v1.schema.json",
  "title": "DokoDetector table-observation annotation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "annotation_set_id",
    "source",
    "observed_cards",
    "event_review",
    "review_state"
  ],
  "properties": {
    "schema_version": {
      "const": "table-observation-annotation/v1"
    },
    "annotation_set_id": {
      "$ref": "#/$defs/identifier"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "package_id": {"$ref": "#/$defs/identifier"},
        "recording_id": {"$ref": "#/$defs/identifier"},
        "video_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "observed_cards": {
      "type": "array",
      "items": {"$ref": "#/$defs/observed_card"}
    },
    "event_review": {
      "enum": [
        "unreviewed",
        "confirmed_card_play",
        "false_event_proposal",
        "no_visible_cards",
        "card_not_visible",
        "visible_but_not_identifiable",
        "ambiguous_card",
        "insufficient_visual_evidence"
      ]
    },
    "review_state": {
      "enum": ["draft", "reviewed"]
    },
    "video_snippet": {
      "$ref": "#/$defs/video_snippet"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "bbox": {
      "type": ["array", "null"],
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "integer", "minimum": 0}
    },
    "frame_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "bbox", "usable_for_identity", "tags"],
      "properties": {
        "frame_id": {"$ref": "#/$defs/identifier"},
        "observation_id": {"$ref": "#/$defs/identifier"},
        "bbox": {"$ref": "#/$defs/bbox"},
        "usable_for_identity": {"type": "boolean"},
        "tags": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        }
      }
    },
    "observed_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_card_id",
        "visual_card_identity",
        "visibility",
        "frame_observations",
        "became_newly_visible",
        "active_area_class"
      ],
      "properties": {
        "observed_card_id": {"$ref": "#/$defs/identifier"},
        "visual_card_identity": {
          "type": ["string", "null"],
          "enum": [
            null,
            "CLUBS_NINE", "CLUBS_JACK", "CLUBS_QUEEN", "CLUBS_KING", "CLUBS_TEN", "CLUBS_ACE",
            "SPADES_NINE", "SPADES_JACK", "SPADES_QUEEN", "SPADES_KING", "SPADES_TEN", "SPADES_ACE",
            "HEARTS_NINE", "HEARTS_JACK", "HEARTS_QUEEN", "HEARTS_KING", "HEARTS_TEN", "HEARTS_ACE",
            "DIAMONDS_NINE", "DIAMONDS_JACK", "DIAMONDS_QUEEN", "DIAMONDS_KING", "DIAMONDS_TEN", "DIAMONDS_ACE"
          ]
        },
        "visibility": {
          "enum": [
            "identifiable",
            "card_not_visible",
            "visible_but_not_identifiable",
            "ambiguous_card"
          ]
        },
        "frame_observations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/frame_observation"}
        },
        "became_newly_visible": {"type": "boolean"},
        "active_area_class": {
          "type": ["string", "null"],
          "enum": ["inside", "outside", "uncertain", "not_applicable", null]
        },
        "card_tracklet_id": {
          "type": ["string", "null"],
          "anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]
        },
        "movement": {
          "type": ["string", "null"],
          "enum": ["stationary", "moving", "reappeared", "unknown", null]
        },
        "occlusion": {
          "type": ["string", "null"],
          "enum": ["none", "short", "complete", "unknown", null]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"visibility": {"const": "identifiable"}}
          },
          "then": {
            "properties": {
              "visual_card_identity": {"type": "string"}
            }
          }
        }
      ]
    },
    "video_snippet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video_snippet_id", "start_ms", "end_ms"],
      "properties": {
        "video_snippet_id": {"$ref": "#/$defs/identifier"},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "exclusiveMinimum": 0}
      }
    }
  }
}
