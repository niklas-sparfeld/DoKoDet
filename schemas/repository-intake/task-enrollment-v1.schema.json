{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doko-detector.local/schemas/task-enrollment-v1.schema.json",
  "title": "DokoDetector initial task enrollment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_asset_id", "enrollments"],
  "properties": {
    "schema_version": {"const": "task-enrollment/v1"},
    "source_asset_id": {"$ref": "#/$defs/identifier"},
    "enrollments": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/enrollment"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "enrollment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_enrollment_id", "task", "disposition", "lifecycle_state", "operator",
        "created_at_utc", "reason"
      ],
      "properties": {
        "task_enrollment_id": {"$ref": "#/$defs/identifier"},
        "task": {"enum": ["cardevent_event_detection", "table_evidence_analysis"]},
        "disposition": {"enum": ["selected", "deferred", "excluded"]},
        "lifecycle_state": {
          "enum": [
            "intake", "annotating", "review_required", "reviewed", "eligible", "excluded", "retired"
          ]
        },
        "operator": {"type": "string", "minLength": 1},
        "created_at_utc": {"$ref": "#/$defs/timestamp"},
        "reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"enum": ["selected", "deferred"]}}},
          "then": {
            "properties": {
              "lifecycle_state": {"const": "intake"},
              "reason": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"disposition": {"const": "excluded"}}},
          "then": {
            "properties": {
              "lifecycle_state": {"const": "excluded"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    }
  }
}
