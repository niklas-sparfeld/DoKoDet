{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doko-detector.local/schemas/pending-video-completion-v1.schema.json",
  "title": "DokoDetector pending video completion metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_asset_id", "recording_id", "video_id", "session_id",
    "acquisition_method", "source_permission", "allowed_uses", "game_id", "round_id",
    "table_setup", "content_type", "notes", "task_enrollments"
  ],
  "properties": {
    "schema_version": {"const": "pending-video-completion/v1"},
    "source_asset_id": {"$ref": "#/$defs/identifier"},
    "recording_id": {"$ref": "#/$defs/identifier"},
    "video_id": {"$ref": "#/$defs/identifier"},
    "session_id": {"$ref": "#/$defs/identifier"},
    "acquisition_method": {"type": "string", "minLength": 1},
    "source_permission": {
      "enum": ["training_only", "training_and_evaluation", "project_use", "unrestricted"]
    },
    "allowed_uses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["train", "validation", "test", "evaluation"]}
    },
    "game_id": {"$ref": "#/$defs/nullable_identifier"},
    "round_id": {"$ref": "#/$defs/nullable_identifier"},
    "table_setup": {"$ref": "#/$defs/identifier"},
    "content_type": {
      "enum": ["real_game", "staged_trick_sequence", "staged_scenario", "synthetic_render", "other"]
    },
    "notes": {"type": ["string", "null"]},
    "task_enrollments": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/task_enrollment"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "nullable_identifier": {
      "anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]
    },
    "task_enrollment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_enrollment_id", "task", "disposition", "lifecycle_state", "operator",
        "created_at_utc", "reason"
      ],
      "properties": {
        "task_enrollment_id": {"$ref": "#/$defs/identifier"},
        "task": {"enum": ["cardevent_event_detection", "table_evidence_analysis"]},
        "disposition": {"enum": ["selected", "deferred", "excluded"]},
        "lifecycle_state": {
          "enum": ["intake", "annotating", "review_required", "reviewed", "eligible", "excluded", "retired"]
        },
        "operator": {"type": "string", "minLength": 1},
        "created_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "reason": {"type": ["string", "null"]}
      }
    }
  }
}
