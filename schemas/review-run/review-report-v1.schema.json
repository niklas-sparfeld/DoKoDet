{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doko-detector.local/schemas/review-report-v1.schema.json",
  "title": "DokoDetector review report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "reviewer", "requested_tasks", "state", "tasks",
    "next_action", "commit_ready_files", "log_path", "generated_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "doko-review-report/v1"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "reviewer": {"type": "string", "minLength": 1},
    "requested_tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["cardevent_event_detection", "table_evidence_analysis"]}
    },
    "state": {"enum": ["new", "in_progress", "interrupted", "failed", "complete"]},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task", "state", "selected_sources", "completed_decisions", "total_decisions", "published_outputs", "failure"],
        "properties": {
          "task": {"enum": ["cardevent_event_detection", "table_evidence_analysis"]},
          "state": {"enum": ["pending", "in_progress", "failed", "complete"]},
          "selected_sources": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "completed_decisions": {"type": "integer", "minimum": 0},
          "total_decisions": {"type": "integer", "minimum": 0},
          "published_outputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "failure": {"anyOf": [{"$ref": "#/$defs/failure"}, {"type": "null"}]}
        }
      }
    },
    "next_action": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "commit_ready_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "log_path": {"type": "string", "minLength": 1},
    "generated_at_utc": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
