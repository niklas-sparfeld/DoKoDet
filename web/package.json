{
  "name": "dokodetector-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "generate:openapi": "mise exec -- uv run --project ../backend python ../backend/scripts/export_openapi.py --output .generated/openapi.json",
    "generate:api": "npm run generate:openapi && openapi-typescript .generated/openapi.json --output src/api/openapi.ts",
    "verify:api": "npm run generate:openapi && openapi-typescript .generated/openapi.json --output .generated/openapi.ts && diff -u .generated/openapi.ts src/api/openapi.ts",
    "check": "npm run typecheck && npm run check:visible-card-boundaries && npm run lint && npm run format && npm run verify:api && npm test",
    "check:visible-card-boundaries": "node scripts/check-visible-card-boundaries.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
